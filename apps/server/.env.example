NODE_ENV=development
HOST=127.0.0.1
PORT=4310
DATABASE_URL=postgres://fanshuye:fanshuye@127.0.0.1:5432/fanshuye
SESSION_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost
LOG_LEVEL=info
TRUST_PROXY=false
SYNC_RETENTION_DAYS=30
DEPENDENCY_QUERY_TIMEOUT_MS=1500
DEPENDENCY_QUERY_MAX_NODES=250
METRICS_TOKEN=replace-with-a-dedicated-random-token-at-least-32-characters
EMAIL_PROVIDER=none
# Production: EMAIL_PROVIDER=resend, then inject a secret RESEND_API_KEY and a verified sender.
# RESEND_API_KEY=re_replace-with-a-secret-key
# VERIFICATION_EMAIL_FROM=番薯叶 <no-reply@example.com>
EMAIL_DELIVERY_TIMEOUT_MS=10000
